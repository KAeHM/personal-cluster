{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "comunidades-prod",
    "namespace": "argocd",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "51"
    }
  },
  "spec": {
    "project": "comunidades",
    "source": {
      "repoURL": "git@github.com:KAeHM/comunidades-infra.git",
      "targetRevision": "main",
      "path": "environments/prod"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "comunidades-prod"
    },
    "syncPolicy": {
      "syncOptions": [
        "ServerSideApply=true",
        "PruneLast=true"
      ]
    }
  }
}
