# Copie este arquivo para .env.local.
# cp .env.example .env.local
#
# A main usa a stack default: Drizzle + Postgres + NextAuth (Credentials).
# Branches de feature reusam estas envs; trocas de stack adicionam/removem o
# que precisarem nos seams de infrastructure.

# Ex.: NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Banco de dados (Drizzle + Postgres) ---

# String de conexao Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Autenticacao (NextAuth / Auth.js v5) ---

# Segredo de assinatura da sessao JWT. Gere com: npx auth secret
AUTH_SECRET=

# URL canonica da app (opcional em dev; util atras de proxy)
# AUTH_URL=http://localhost:3000

# --- API externa (/api/v1) ---

# Chave usada pelos Route Handlers para autenticar consumo externo
API_KEY=

# --- Observabilidade ---

# Nível de log Pino: debug | info | warn | error
LOG_LEVEL=info

# Nome do serviço em logs e traces OpenTelemetry
OTEL_SERVICE_NAME=web

# Endpoint OTLP (Grafana Alloy, Tempo, collector local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Desabilita export de traces (útil localmente sem collector)
# OTEL_SDK_DISABLED=true
