# Template — copie para secrets.local.yaml, preencha e rode scripts/seal-secrets.sh
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: {{APP_SLUG}}
type: Opaque
stringData:
  POSTGRES_PASSWORD: "CHANGE_ME"
  DATABASE_URL: "postgresql://admin:CHANGE_ME@postgres.{{APP_SLUG}}.svc.cluster.local:5432/{{DB_NAME}}"
  AUTH_SECRET: "CHANGE_ME"
  API_KEY: "CHANGE_ME"
