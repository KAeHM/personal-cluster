# Copie este arquivo para .env.local.
# cp .env.example .env.local
#
# Stack: Supabase Cloud (Auth + Postgres + Realtime + Storage).
# Crie um projeto em https://supabase.com/dashboard e copie as chaves em
# Settings → API. Vincule a CLI com: supabase link --project-ref <ref>

# Ex.: NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase Cloud ---

# URL do projeto (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Chave anon/publica (segura no browser com RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service role (somente servidor — nunca exponha no client)
SUPABASE_SERVICE_ROLE_KEY=

# --- API externa (/api/v1) ---

# Chave usada pelos Route Handlers para autenticar consumo externo
API_KEY=

# --- Observabilidade ---

# Nível de log Pino: debug | info | warn | error
LOG_LEVEL=info

# Nome do serviço em logs e traces OpenTelemetry
OTEL_SERVICE_NAME=taeria

# Endpoint OTLP (Grafana Alloy, Tempo, collector local)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Desabilita export de traces (útil localmente sem collector)
# OTEL_SDK_DISABLED=true

# --- Studio Create (Gemini) ---

# Chave do Google AI Studio — somente servidor
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelos (defaults: gemini-2.5-flash / gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro

# Limite de tokens na saída (defaults no código: 8192 fast, 16384 pro/lore)
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MAX_OUTPUT_TOKENS_PRO=16384

# Modelo de embeddings do RAG (default: gemini-embedding-001, 1536 dims)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
