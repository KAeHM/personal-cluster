# ── Database ──
# Docker Compose (dev local):
DATABASE_URL=postgresql://timetracker:timetracker@localhost:5432/timetracker
# Neon (prod/preview):
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ── Auth (NextAuth) ──
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# OAuth (opcional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic link (opcional — Resend)
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=noreply@example.com

# ── AI (Google Gemini) ──
GOOGLE_GENERATIVE_AI_API_KEY=

# ── WhatsApp (Evolution API) ──
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=dev-secret-key-change-me
EVOLUTION_INSTANCE=timetracker-dev
WEBHOOK_SECRET=

# Dev only — self-chat no mesmo número da instância (mensagem para si mesmo)
# WHATSAPP_SELF_TEST_MODE=true
# WHATSAPP_SELF_PHONE=5511999999999

# Logs detalhados do fluxo IA no console ([ai:...]) — ativo por padrão em development
# AI_DEBUG=true
